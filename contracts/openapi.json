  "components": {
    "schemas": {
      "AAASnapshot": {
        "properties": {
          "source": {
            "type": "string",
            "title": "Source",
            "default": "aaa"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          },
          "state": {
            "type": "string",
            "title": "State"
          },
          "price_as_of": {
            "type": "string",
            "format": "date",
            "title": "Price As Of"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time",
            "title": "Retrieved At"
          },
          "update_frequency": {
            "type": "string",
            "title": "Update Frequency",
            "default": "daily"
          },
          "currency": {
            "type": "string",
            "title": "Currency",
            "default": "USD"
          },
          "volume_unit": {
            "type": "string",
            "title": "Volume Unit",
            "default": "US_gallon"
          },
          "regions": {
            "items": {
              "$ref": "#/components/schemas/RegionAverage"
            },
            "type": "array",
            "title": "Regions"
          },
          "county_status": {
            "type": "string",
            "title": "County Status"
          }
        },
        "type": "object",
        "required": [
          "source_url",
          "state",
          "price_as_of",
          "retrieved_at",
          "regions",
          "county_status"
        ],
        "title": "AAASnapshot"
      },
