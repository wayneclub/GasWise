GASWISE_MODE=demo
GASWISE_GOOGLE_API_KEY=
GASWISE_API_TOKEN=
GASWISE_CORS_ORIGINS=["http://localhost:5173"]
GASWISE_REFRESH_SECONDS=300
GASWISE_MAX_CONCURRENT_SEARCHES=2
# Undocumented website adapter; requires a postal_code in each search and API_TOKEN.
GASWISE_GASBUDDY_WEB_ENABLED=false
# Optional contracted adapter exposing the GasWise normalized feed schema (not a GasBuddy public endpoint).
# GASWISE_GASBUDDY_FEED_URL=https://your-contracted-adapter.example/prices
GASWISE_GASBUDDY_FEED_TOKEN=
GASWISE_GASBUDDY_WEB_TRANSPORT=http
GASWISE_GASBUDDY_BROWSER_CHANNEL=chrome
GASWISE_GASBUDDY_BROWSER_TIMEOUT_SECONDS=35
# Optional legacy browser transports only; default HTTP transport ignores browser settings.
GASWISE_GASBUDDY_BROWSER_HEADLESS=false

GASWISE_GASBUDDY_SESSION_SECONDS=600

# Independent normalized price services (see docs/price-source-integration.md).
# GASWISE_PRICE_SOURCES='[{"source_id":"partner_prices","url":"https://prices.example.com/v1/stations","token":"REPLACE_ME","enabled":true,"timeout_seconds":15}]'
