GASWISE_MODE=demo
# Enable only after Routes API/key authorization; smart search defaults to prices only.
GASWISE_GOOGLE_ROUTES_ENABLED=false
# Google Maps website HTTP directions: separate from paid Routes API, requires live mode and API_TOKEN.
GASWISE_MAPS_WEB_ROUTES_ENABLED=false
GASWISE_GOOGLE_API_KEY=
GASWISE_API_TOKEN=
GASWISE_CORS_ORIGINS=["http://localhost:5173"]
GASWISE_REFRESH_SECONDS=300
GASWISE_MAX_CONCURRENT_SEARCHES=2
# Optional plate source: autozone needs no upstream key; GasWise API_TOKEN is required.
GASWISE_PLATE_LOOKUP_ENABLED=false
GASWISE_PLATE_LOOKUP_SOURCE=autozone
GASWISE_VEHICLE_DATABASES_API_KEY=
# Undocumented website adapter; requires a postal_code in each search and API_TOKEN.
GASWISE_GASBUDDY_WEB_ENABLED=false
# Optional contracted adapter exposing the GasWise normalized feed schema (not a GasBuddy public endpoint).
# GASWISE_GASBUDDY_FEED_URL=https://your-contracted-adapter.example/prices
GASWISE_GASBUDDY_FEED_TOKEN=
GASWISE_GASBUDDY_WEB_TRANSPORT=http
GASWISE_GASBUDDY_BROWSER_CHANNEL=chrome
GASWISE_GASBUDDY_BROWSER_TIMEOUT_SECONDS=35
# Optional legacy browser transports only; default HTTP transport ignores browser settings.
GASWISE_GASBUDDY_BROWSER_HEADLESS=false

GASWISE_GASBUDDY_SESSION_SECONDS=600
# GasBuddy only serves US traffic. Non-US hosts set one fixed US egress proxy, e.g. http://gluetun:8888
# GASWISE_GASBUDDY_HTTP_PROXY=

# Opt-in undocumented Waze HTTP source. Requires live mode, API_TOKEN and private credential files.
GASWISE_WAZE_ENABLED=false
GASWISE_WAZE_AUTO_LOGIN=true
# GASWISE_WAZE_SESSION_FILE=/absolute/private/path/waze-http-session.json
# GASWISE_WAZE_LOGIN_FILE=/absolute/private/path/waze-http-login.bin

# Independent normalized price services (see docs/price-source-integration.md).
# GASWISE_PRICE_SOURCES='[{"source_id":"partner_prices","url":"https://prices.example.com/v1/stations","token":"REPLACE_ME","enabled":true,"timeout_seconds":15}]'
# Optional, explicitly authorized Google Maps login session. Keep outside the repository, mode 0600.
# GASWISE_MAPS_WEB_SESSION_FILE=/Users/you/.config/gaswise/google-maps-http-session.json

# Public specification lookups + labeled US grade estimates; no PDFs or paid APIs.
# false preserves manufacturer-only numeric requirements.
GASWISE_VEHICLE_SPECIFICATIONS_ENABLED=true

# Pure HTTP with Chrome TLS profile, no browser/JS/cookies/auth replay. httpx remains available.
GASWISE_VEHICLE_SPECIFICATIONS_TRANSPORT=curl

# Anonymous public parts lookup; separate from local API authentication
GASWISE_PARTS_SOURCES_ENABLED=true
GASWISE_PARTS_HTTP_TRANSPORT=curl

# TOP TIER licensed-brand list: scheduled refresh (hours), never per search. Bundled snapshot is the fallback.
GASWISE_TOP_TIER_REFRESH_ENABLED=true
GASWISE_TOP_TIER_REFRESH_HOURS=168
# GASWISE_TOP_TIER_CACHE_FILE=/Users/you/.cache/gaswise/top-tier-brands.json

# Shared public pricing cache on an EXISTING PostgreSQL server; no database container is needed.
# Keep the actual URL/password in private deployment configuration, never in Git.
# GASWISE_DATABASE_URL=postgresql://gaswise_cache:REPLACE_ME@postgres:5432/gaswise
GASWISE_PRICING_CACHE_FRESH_SECONDS=900
GASWISE_GASBUDDY_REQUESTS_PER_MINUTE=12
GASWISE_MAPS_REQUESTS_PER_MINUTE=60
GASWISE_WAZE_REQUESTS_PER_MINUTE=20
